<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 临时改为 Exe 以显示控制台输出用于调试 -->
    <OutputType>Exe</OutputType>
    <!--
      WebView.Avalonia.MacCatalyst 11.0.0.1 bundles a Xamarin.Mac bridge that
      performs an ambiguous Marshal reflection lookup on .NET 9/10. Keep the
      desktop runtime on .NET 8 until that WebView dependency is replaced.
      The repository may still be built with the .NET 10 SDK.
    -->
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64;osx-x64;osx-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <Version>0.10.1</Version>
    <!-- Azure 发布时注入 Build.BuildId，使“设置”中的版本与下载文件名/Release 标签一致。 -->
    <InformationalVersion Condition="'$(NcfDesktopBuildNumber)' != ''">$(Version)-build$(NcfDesktopBuildNumber)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion Condition="'$(NcfDesktopBuildNumber)' != ''">false</IncludeSourceRevisionInInformationalVersion>
    <PackageReleaseNotes>
      [2026-07-24] v0.1.0 增强桌面端更新、下载反馈与窗口兼容性
      1、动态测速选择 GitHub 与镜像更新源，并在下载失败时自动切换备用源
      2、增加下载过程日志和进度反馈，并按目标版本检测及安装 .NET 运行时
      3、修复高 DPI 屏幕窗口尺寸计算并改善内嵌 WebView 导航兼容性
      [2026-07-25] v0.2.0 新增可选 DesktopBridge 与桌面机器人
      1、增加透明置顶桌面机器人，实时提示 NCF 启动、运行、任务完成和失败状态
      2、增加带随机会话令牌的 DesktopBridge 能力探测与 SSE 客户端
      3、内部站点未安装、版本不兼容或连接失败时安全降级到进程日志模式并显示安装提示
      [2026-07-25] v0.3.0 新增多版本 NCF 启动目标与 Agent 工作台
      1、支持内置托管版本、外部发布目录和 Senparc.Web 源码工作区
      2、外部目标隔离自动更新和解压流程，源码模式使用 no-restore 安全启动
      3、重构目标选择、运行状态和 Agent 活动流界面，并持久化最近使用目标
      [2026-07-26] v0.3.1 修复 macOS 内嵌浏览器复制粘贴快捷键
      1、增加 NativeMenu Edit（⌘C/⌘V/⌘X/⌘A）并桥接到 WKWebView
      2、粘贴从系统剪贴板写入页面输入框，普通打字不受影响
      [2026-07-26] v0.3.2 修复停止目标后应用退出
      1、停止 NCF 仅终止子进程，桌面主窗口保持打开并回到工作台
      2、避免后台线程更新 UI 与 entireProcessTree 误杀导致进程崩溃
      [2026-07-28] v0.3.3 修复 macOS WebView JavaScript 回调闪退
      1、规避 WebView.Avalonia.MacCatalyst 11.0.0.1 空结果回调导致的主线程 SIGABRT
      2、macOS 使用 WKWebView/AppKit 原生编辑命令，Windows 和 Linux 保持原有脚本桥
      3、重建 macOS 应用包和 DMG 前清理残留并处理失败临时文件
      [2026-07-30] v0.4.0 新增远程、多工作台与在线模板能力
      1、复用 DesktopBridge HTTP/SSE 适配层连接 HTTPS 远程 NCF，站点内部继续使用 EventBus
      2、支持同一桌面进程创建多个独立工作台窗口，隔离进程、端口、Bridge、浏览器和 Admin Chat 会话
      3、从 NuGet.org 安装最新 Senparc.NCF.Template 并创建不会覆盖现有目录的源码工作区
      4、远程令牌只保存在内存，非回环 HTTP 被拒绝，HTTPS 使用系统服务端证书校验
      [2026-08-01] v0.4.1 新增远程 DesktopBridge 管理员配对
      1、远程令牌留空时自动申请短期配对码，并轮询管理员审批结果
      2、批准后直接使用独立会话令牌连接，无需重启 Senparc.Web
      3、保留手工令牌模式，配对信息和令牌均不写入桌面设置
      [2026-08-01] v0.5.0 新增 AdminChat 本地语音输入
      1、使用 SoundFlow 录制麦克风并通过 Whisper.net 在本机离线转写，结果仅写入输入框且不会自动发送
      2、工作台设置支持选择并下载 Tiny、Base、Small 多语言模型，或手动加载本地 GGML 模型
      3、AdminChat 输入区和桌面机器人均可触发语音输入，开始录音前强制检查模型是否已选择且完整
      [2026-08-01] v0.5.1 优化远程授权退出和内置浏览器
      1、管理员撤销 DesktopBridge 会话后立即停止当前网站并清理 Admin Chat 和内置网页，桌面应用保持打开
      2、删除无实现的前进后退、重复打开和危险的停止站点按钮，保留必要浏览器操作
      3、移除常驻的页面加载完成横条，在工具栏中显示紧凑加载状态
      [2026-08-04] v0.6.0 增强本地语音、桌面机器人与运行时兼容性
      1、GUI 和测试固定为 net8.0 以兼容 macOS WebView 原生桥，同时保留 Microsoft.Extensions 10 与依赖安全更新
      2、六个平台继续使用自包含单文件发布，目标电脑无需预装 .NET Runtime
      3、macOS 架构 ZIP 改为包含可双击的 .app，并额外发布 Universal .app 压缩包和 DMG
      4、新增默认关闭的固定唤醒词“你好 Cici”，使用单关键词 INT8 流式模型；关闭后立即释放麦克风
      5、新增 AdminChat 本地流式朗读，按 SSE 短句增量合成并清理 Markdown、链接和代码内容
      6、增加默认关闭的语音识别自动发送选项，并协调录音、唤醒检测和本地朗读的取消与资源释放
      7、支持桌面机器人滚轮缩放、最大倍率限制和多屏位置持久化，恢复时确保浮窗完整可见
      8、修复 Windows 发布门禁读取已有标签时的误报失败，允许尚未发布的版本继续完成构建与发布
      [2026-08-04] v0.7.0 优化 macOS 内嵌浏览器 WebView 兼容性
      [2026-08-08] v0.8.0 整合单主窗口工作台与桌面机器人布局
      1、多个工作台窗口合并为单主窗口侧栏标签，统一会话、浏览器和 Admin Chat 生命周期
      2、新增桌面机器人布局模式，并增强 Admin Chat 与 Agent Portal 联动
      3、改进桌面活动、通知资源管理与状态同步
      [2026-08-08] v0.8.1 修复桌面机器人透明浮窗与展开定位
      1、macOS 透明浮窗改由 Avalonia ExtendClientArea 创建透明 surface，不再覆盖 NSWindow 背景属性
      2、展开/收起状态卡片保持相同窗口高度与吉祥物位置，避免形象在屏幕上跳动
      3、缩放与关闭时直接使用窗口实际坐标持久化位置，移除额外顶偏移换算
      4、优化群组浮窗操作按钮的内边距与内容对齐
      [2026-08-08] v0.9.0 新增中英双语界面
      1、支持中文与英文界面语言，设置中可切换，默认中文
      2、切换语言后立即刷新主窗口、工作台、设置与宠物等用户可见文案，无需重启
      3、界面语言偏好持久化到桌面端用户设置
      [2026-08-10] v0.9.1 增强生命周期诊断、AdminChat 稳定性与 Agent Portal
      1、CrashDiagnostic 增加生命周期日志；UI 调度器与未观察任务异常记录后标记已处理，避免外围音频/WebView 故障拖垮主进程
      2、AdminChat 会话刷新增加并发保护与异常降级；授权同步失败回调不再二次拉会话或停流，降低 macOS 登录后主窗口被打断风险
      3、macOS 固定唤醒词：已保存“开启”不会在登录瞬间自动触发麦克风授权，需本会话内手动关闭后再开启；唤醒监听与处理异常时安全停止
      4、桌面机器人 Agent Portal 支持约屏高 68% 的圆形展开、返回宠物、透明命中区与定位同步
      5、细化主窗口关闭与退出清理逻辑，减少非预期退出
      [2026-08-10] v0.10.0 新增唤醒词录音端点检测与自动发送
      1、新增本地 VoiceEndpointDetector：校准底噪后确认持续人声，约 1.35 秒静音判为讲话结束；无有效讲话约 8 秒超时取消（仅唤醒词录音；手动录音仍需点停）
      2、唤醒词启动的录音在说完后自动停录、本机 Whisper 转写并始终自动发送；仅发送本次识别文本，不夹带输入框草稿；AdminChat 忙碌时排队待空闲再发
      3、设置项「STT 自动发送」改为仅控制手动麦克风识别结果；中英文案与 macOS 麦克风用途说明同步更新
      4、TTS 朗读期间仍可监听唤醒词；检测到唤醒后先停止朗读再开始录音，并支持在回复流式进行中打断后录音
      5、修正 build-tool 中 macOS .app 脚本路径解析，避免发布流程找错脚本
      6、macOS 已保存的唤醒词开启状态在新会话中不再自动占用麦克风，设置页提供当前会话显式激活入口并安全刷新监听状态
      7、补充中英文唤醒词启用与操作提示，统一设置界面反馈，降低唤醒词权限与监听状态误解
      [2026-08-15] v0.10.1 增强风噪端点检测、流式朗读分段与桌面浮窗稳定性
      1、VoiceEndpointDetector 改为 20ms 帧处理，结合语音频带能量、高通滤波与自适应底噪，降低风噪与逐渐变大的稳定背景噪声导致录音拖尾或无法自动结束的问题；单次讲话最长约 30 秒
      2、流式 TTS 首段降低强边界门槛以更快开播；后续段在期望长度附近等待标点至扩展上限，减少句中硬切；完整文本分段与流式路径共用同一强弱边界规则
      3、Agent Portal 对 AgentsManager 快照中的重复 Agent/工作组/连线/协作关系按稳定 Id 去重，避免渲染索引冲突导致 UI 进程退出
      4、macOS 透明桌面机器人窗口在 Hide 后重新 Show 时刷新原生 opaque/background，并统一群组窗与单宠窗的显示路径，减少多透明顶层窗口来回切换后的黑底或失透
    </PackageReleaseNotes>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- 应用程序图标（Windows 可执行文件图标） -->
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <Content Include="Assets\Localization\*.json" CopyToOutputDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="NcfDesktopApp.GUI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.2" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.2" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.2">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.4" />
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <PackageReference Include="SoundFlow" Version="1.4.1" />
    <PackageReference Include="Whisper.net" Version="1.8.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.8.1" />
    <!-- WebView.Avalonia cross-platform packages (在 Windows 上自动使用 WebView2) -->
    <PackageReference Include="WebView.Avalonia" Version="11.0.0.1" />
    <PackageReference Include="WebView.Avalonia.Desktop" Version="11.0.0.1" />
  </ItemGroup>
</Project>
