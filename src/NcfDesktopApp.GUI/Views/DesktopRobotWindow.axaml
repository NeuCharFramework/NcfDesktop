<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NcfDesktopApp.GUI.ViewModels"
        xmlns:loc="using:NcfDesktopApp.GUI.Markup"
        xmlns:controls="using:NcfDesktopApp.GUI.Views.Controls"
        x:Class="NcfDesktopApp.GUI.Views.DesktopRobotWindow"
        x:DataType="vm:DesktopRobotViewModel"
        Title="{loc:Loc Robot.WindowTitle}"
        Width="174"
        Height="154"
        MinWidth="0"
        MinHeight="0"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

    <Canvas x:Name="RootSurface"
          Width="158"
          Height="138"
          Margin="8"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          PointerEntered="RevealSurface_OnPointerEntered"
          PointerExited="RootSurface_OnPointerExited"
          PointerMoved="RootBorder_OnPointerMoved">
        <Canvas.ContextMenu>
            <ContextMenu>
                <MenuItem Header="{loc:Loc Robot.VoiceInput}"
                          Click="VoiceInputMenuItem_OnClick"/>
                <MenuItem Header="{loc:Loc Robot.AgentPortal}"
                          IsEnabled="{Binding IsAgentPortalAvailable}"
                          Click="AgentPortalMenuItem_OnClick"/>
                <MenuItem Header="{loc:Loc Robot.OpenNeuBell}"
                          IsEnabled="{Binding HasNeuBellNotifications}"
                          ToolTip.Tip="{Binding NeuBellSummary}"
                          Click="NeuBellMenuItem_OnClick"/>
                <Separator/>
                <MenuItem Header="{loc:Loc Robot.FollowWorkState}"
                          Click="MascotAutoMenuItem_OnClick"/>
                <Separator/>
                <MenuItem Header="{loc:Loc Robot.MascotNono}"
                          Tag="Nono"
                          Click="MascotMenuItem_OnClick"/>
                <MenuItem Header="{loc:Loc Robot.MascotCici}"
                          Tag="Cici"
                          Click="MascotMenuItem_OnClick"/>
                <MenuItem Header="{loc:Loc Robot.MascotQiao}"
                          Tag="Qiao"
                          Click="MascotMenuItem_OnClick"/>
                <MenuItem Header="{loc:Loc Robot.MascotOpsi}"
                          Tag="Opsi"
                          Click="MascotMenuItem_OnClick"/>
            </ContextMenu>
        </Canvas.ContextMenu>

        <!-- 默认隐藏的信息卡。宠物和状态位于其上方，形成从圆形入口探出的效果。 -->
        <Border x:Name="ExpandedCard"
                IsVisible="False"
                ZIndex="10"
                Width="342"
                Height="138"
                Padding="76,40,12,12"
                CornerRadius="18"
                Background="#F4FFFFFF"
                BorderBrush="#26007ACC"
                BorderThickness="1"
                BoxShadow="0 6 22 0 #42000000"
                PointerPressed="RootBorder_OnPointerPressed">
            <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="4">
                <TextBlock Grid.Row="0"
                           Text="{Binding Title}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Row="1"
                           Text="{Binding Detail}"
                           FontSize="11.5"
                           Foreground="#444444"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           MaxHeight="36"/>

                <ProgressBar Grid.Row="2"
                             Value="{Binding Progress}"
                             IsVisible="{Binding IsProgressVisible}"
                             Height="4"
                             Margin="0,1,0,1"/>

                <Grid Grid.Row="3"
                      ColumnDefinitions="*,Auto,Auto,Auto"
                      ColumnSpacing="8">
                    <TextBlock Text="{Binding ConnectionText}"
                               FontSize="10"
                               Foreground="#777777"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="1"
                            Width="38"
                            Height="30"
                            Padding="0"
                            Background="#2563EB"
                            Foreground="White"
                            CornerRadius="8"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="{loc:Loc Robot.VoiceTip}"
                            Click="VoiceInputButton_OnClick">
                        <Viewbox Width="17" Height="17" IsHitTestVisible="False">
                            <Canvas Width="16" Height="16">
                                <Path Data="M 8,1 C 6.35,1 5,2.35 5,4 L 5,8 C 5,9.65 6.35,11 8,11 C 9.65,11 11,9.65 11,8 L 11,4 C 11,2.35 9.65,1 8,1 Z"
                                      Fill="White"/>
                                <Path Data="M 3,7.5 L 3,8 C 3,10.76 5.24,13 8,13 C 10.76,13 13,10.76 13,8 L 13,7.5 M 8,13 L 8,15 M 5.5,15 L 10.5,15"
                                      Stroke="White"
                                      StrokeThickness="1.4"
                                      StrokeLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Grid.Column="2"
                            Content="{Binding AgentPortalActionText}"
                            IsEnabled="{Binding IsAgentPortalAvailable}"
                            FontSize="10"
                            Padding="9,4"
                            Background="#6D28D9"
                            Foreground="White"
                            CornerRadius="8"
                            ToolTip.Tip="{Binding AgentPortalStatusText}"
                            Click="AgentPortalButton_OnClick"/>
                    <Button Grid.Column="3"
                            Content="{loc:Loc Robot.OpenNcf}"
                            FontSize="10"
                            Padding="10,4"
                            Background="#007ACC"
                            Foreground="White"
                            CornerRadius="8"
                            Click="OpenMainButton_OnClick"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Agents 门户独立于宠物图层：退出时门户可在底层缩回，同时立即露出宠物。 -->
        <controls:AgentPortalView x:Name="AgentPortalSurface"
                                  ZIndex="15"
                                  IsOpen="{Binding IsAgentPortalOpen}"
                                  Nodes="{Binding AgentPortalNodes}"
                                  IsHitTestVisible="False"/>

        <Button x:Name="PortalReturnButton"
                IsVisible="False"
                ZIndex="60"
                Width="84"
                Height="34"
                Padding="10,4"
                Background="#6D28D9"
                Foreground="White"
                CornerRadius="17"
                FontSize="11"
                FontWeight="SemiBold"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Content="{Binding AgentPortalActionText}"
                ToolTip.Tip="{Binding AgentPortalStatusText}"
                PointerPressed="PortalReturnButton_OnPointerPressed"
                Click="PortalReturnButton_OnClick"/>

        <!-- 宠物与信息卡之间的透明悬停桥，避免移动鼠标时卡片提前收起。 -->
        <Border x:Name="HoverBridge"
                IsVisible="False"
                ZIndex="15"
                Width="30"
                Height="54"
                Background="#01000000"/>

        <!-- 状态轻微覆盖宠物右上角，缩放时始终锚定可见圆形外圈。 -->
        <Border x:Name="CompactStatus"
                ZIndex="30"
                Height="26"
                MinHeight="0"
                MaxWidth="110"
                Padding="9,0"
                CornerRadius="9"
                Background="{Binding StateColor}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
            <TextBlock Text="{Binding StateText}"
                       FontSize="10"
                       Foreground="White"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </Border>

        <Button x:Name="HideRobotButton"
                IsVisible="False"
                ZIndex="40"
                Width="24"
                Height="24"
                Padding="0"
                Background="#E8E8E8"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                ToolTip.Tip="{loc:Loc Robot.HideTip}"
                Click="HideButton_OnClick">
            <Path Width="10"
                  Height="10"
                  Data="M 1,1 L 9,9 M 9,1 L 1,9"
                  Stretch="Uniform"
                  Stroke="#666666"
                  StrokeThickness="1.7"
                  StrokeLineCap="Round"
                  IsHitTestVisible="False"/>
        </Button>

        <Grid x:Name="MascotSurface"
              ZIndex="20"
              Width="112"
              Height="112"
              IsVisible="{Binding IsMascotVisible}"
              RenderTransformOrigin="0%,0%"
              PointerPressed="RootBorder_OnPointerPressed"
              PointerWheelChanged="MascotSurface_OnPointerWheelChanged"
              DoubleTapped="MascotSurface_OnDoubleTapped"
              ToolTip.Tip="{loc:Loc Robot.MascotTip}">
            <controls:AudioGlowRingView Mode="{Binding AudioVisualizationMode}"
                                        Level="{Binding AudioVisualizationLevel}"
                                        Bands="{Binding AudioVisualizationBands}"
                                        InnerDiameter="64"
                                        IsVisible="{Binding IsMascotVisible}"/>
            <Border Width="64"
                    Height="64"
                    CornerRadius="32"
                    Background="#F7FFFFFF"
                    BorderBrush="{Binding StateColor}"
                    BorderThickness="2"
                    BoxShadow="0 2 9 0 #2D000000"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsMascotVisible}">
                <controls:NcfMascotView x:Name="MascotView"
                                        Mascot="{Binding Mascot}"
                                        Pose="{Binding Pose}"
                                        ShowGlasses="True"
                                        ShowAudioAura="False"
                                        GazeX="{Binding GazeX}"
                                        GazeY="{Binding GazeY}"
                                        IsInteracting="{Binding IsInteracting}"
                                        Width="61"
                                        Height="61"
                                        ToolTip.Tip="{Binding MascotName}"/>
            </Border>
            <Button ZIndex="60"
                    Width="30"
                    Height="30"
                    Padding="0"
                    Margin="0,3,3,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="#E11D48"
                    BorderBrush="#FFFFFFFF"
                    BorderThickness="2"
                    CornerRadius="15"
                    Foreground="White"
                    FontSize="9"
                    FontWeight="Bold"
                    Content="{Binding NeuBellBadgeText}"
                    IsVisible="{Binding HasNeuBellNotifications}"
                    ToolTip.Tip="{Binding NeuBellSummary}"
                    PointerPressed="NeuBellButton_OnPointerPressed"
                    Click="NeuBellButton_OnClick"/>
        </Grid>
    </Canvas>
</Window>
