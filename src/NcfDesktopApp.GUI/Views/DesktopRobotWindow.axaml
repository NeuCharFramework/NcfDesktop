<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NcfDesktopApp.GUI.ViewModels"
        xmlns:controls="using:NcfDesktopApp.GUI.Views.Controls"
        x:Class="NcfDesktopApp.GUI.Views.DesktopRobotWindow"
        x:DataType="vm:DesktopRobotViewModel"
        Title="NCF 桌面助手"
        Width="360"
        Height="154"
        MinWidth="320"
        MinHeight="140"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome">

    <Border Margin="8"
            Padding="12"
            CornerRadius="18"
            Background="#F7FFFFFF"
            BorderBrush="#26007ACC"
            BorderThickness="1"
            BoxShadow="0 6 22 0 #42000000"
            PointerPressed="RootBorder_OnPointerPressed"
            PointerMoved="RootBorder_OnPointerMoved"
            PointerExited="RootBorder_OnPointerExited">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="🎙️ AdminChat 语音输入"
                          Click="VoiceInputMenuItem_OnClick"/>
                <Separator/>
                <MenuItem Header="自动跟随工作状态"
                          Click="MascotAutoMenuItem_OnClick"/>
                <Separator/>
                <MenuItem Header="Nono · 默认助手"
                          Tag="Nono"
                          Click="MascotMenuItem_OnClick"/>
                <MenuItem Header="Cici · Agent / Chat"
                          Tag="Cici"
                          Click="MascotMenuItem_OnClick"/>
                <MenuItem Header="Qiao · Bridge / EventBus"
                          Tag="Qiao"
                          Click="MascotMenuItem_OnClick"/>
                <MenuItem Header="Opsi · 构建 / 错误"
                          Tag="Opsi"
                          Click="MascotMenuItem_OnClick"/>
            </ContextMenu>
        </Border.ContextMenu>
        <Grid ColumnDefinitions="84,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
            <Grid Grid.RowSpan="4"
                  Width="80"
                  Height="80"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <controls:AudioGlowRingView Mode="{Binding AudioVisualizationMode}"
                                            Level="{Binding AudioVisualizationLevel}"
                                            Bands="{Binding AudioVisualizationBands}"
                                            InnerDiameter="64"/>
                <Border Width="64"
                        Height="64"
                        CornerRadius="32"
                        Background="#0B64748B"
                        BorderBrush="{Binding StateColor}"
                        BorderThickness="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <controls:NcfMascotView x:Name="MascotView"
                                            Mascot="{Binding Mascot}"
                                            Pose="{Binding Pose}"
                                            ShowGlasses="True"
                                            ShowAudioAura="False"
                                            GazeX="{Binding GazeX}"
                                            GazeY="{Binding GazeY}"
                                            IsInteracting="{Binding IsInteracting}"
                                            Width="61"
                                            Height="61"
                                            ToolTip.Tip="{Binding MascotName}"/>
                </Border>
            </Grid>

            <Grid Grid.Column="1"
                  Grid.Row="0"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8"
                  VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <Border Grid.Column="1"
                        Height="24"
                        MinHeight="0"
                        Padding="7,0"
                        CornerRadius="8"
                        Background="{Binding StateColor}"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding StateText}"
                               FontSize="10"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <Button Grid.Column="2"
                    Grid.Row="0"
                    Width="24"
                    Height="24"
                    Padding="0"
                    Background="Transparent"
                    Foreground="#777777"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    VerticalAlignment="Center"
                    ToolTip.Tip="隐藏桌面助手"
                    Click="HideButton_OnClick">
                <Path Width="10"
                      Height="10"
                      Data="M 1,1 L 9,9 M 9,1 L 1,9"
                      Stretch="Uniform"
                      Stroke="#666666"
                      StrokeThickness="1.7"
                      StrokeLineCap="Round"
                      IsHitTestVisible="False"/>
            </Button>

            <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                       Text="{Binding Detail}"
                       FontSize="12"
                       Foreground="#444444"
                       TextWrapping="Wrap"
                       MaxHeight="38"
                       Margin="0,5,0,2"/>

            <ProgressBar Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2"
                         Value="{Binding Progress}"
                         IsVisible="{Binding IsProgressVisible}"
                         Height="4"
                         Margin="0,3,0,2"/>

            <Grid Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,5,0,0">
                <TextBlock Text="{Binding ConnectionText}"
                           FontSize="10"
                           Foreground="#777777"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1"
                        Content="🎙️"
                        FontSize="12"
                        Padding="8,4"
                        ToolTip.Tip="开始或停止 AdminChat 语音输入"
                        Click="VoiceInputButton_OnClick"/>
                <Button Grid.Column="2"
                        Content="打开 NCF"
                        FontSize="10"
                        Padding="10,4"
                        Background="#007ACC"
                        Foreground="White"
                        CornerRadius="8"
                        Click="OpenMainButton_OnClick"/>
            </Grid>
        </Grid>
    </Border>
</Window>
