<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NcfDesktopApp.GUI.ViewModels"
        xmlns:loc="using:NcfDesktopApp.GUI.Markup"
        x:Class="NcfDesktopApp.GUI.Views.TemplateWorkspaceWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{loc:Loc Template.WindowTitle}"
        Width="680" Height="650"
        MinWidth="540" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Assets/NCF-logo.png">

    <Grid RowDefinitions="Auto,*,Auto"
          ClipToBounds="True"
          Background="{DynamicResource ContentBackgroundBrush}">
        <Border Grid.Row="0"
                Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource ToolbarBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,16">
            <StackPanel Spacing="3">
                <TextBlock Text="{loc:Loc Template.Title}" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="{loc:Loc Template.Subtitle}"
                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      MinHeight="0"
                      ClipToBounds="True"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border Padding="22,18,22,22">
                <StackPanel Spacing="16">
                <Border Background="#102563EB"
                        BorderBrush="#402563EB"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <TextBlock Text="{loc:Loc Template.Intro}"
                               FontSize="11" TextWrapping="Wrap" LineHeight="17"/>
                </Border>

                <StackPanel Spacing="7">
                    <TextBlock Text="{loc:Loc Template.ParentDirectory}" Classes="field-label"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding TemplateWorkspaceParentPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="{loc:Loc Template.ParentWatermark}"
                                 FontFamily="Consolas,Menlo,Monaco,Courier New"
                                 Margin="0,0,8,0"
                                 IsEnabled="{Binding IsTargetSelectionEnabled}"/>
                        <Button Grid.Column="1" Content="{loc:Loc Template.SelectDirectory}"
                                Command="{Binding SelectTemplateWorkspaceParentCommand}"
                                Classes="secondary-action"/>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="7">
                    <TextBlock Text="{loc:Loc Template.WorkspaceName}" Classes="field-label"/>
                    <TextBox Text="{Binding TemplateWorkspaceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Watermark="{loc:Loc Template.NameWatermark}"
                             IsEnabled="{Binding IsTargetSelectionEnabled}"/>
                </StackPanel>

                <StackPanel Spacing="9">
                    <TextBlock Text="{loc:Loc Template.InitialConfig}" Classes="field-label"/>
                    <Border Background="{DynamicResource ToolbarBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="12">
                        <StackPanel Spacing="10">
                            <RadioButton Content="{loc:Loc Template.UseDefault}"
                                         GroupName="TemplateConfigurationSource"
                                         IsChecked="{Binding UsesTemplateDefaultConfiguration, Mode=TwoWay}"
                                         IsEnabled="{Binding IsTargetSelectionEnabled}"/>
                            <StackPanel Spacing="3">
                                <RadioButton Content="{loc:Loc Template.CopyManaged}"
                                             GroupName="TemplateConfigurationSource"
                                             IsChecked="{Binding UsesManagedRuntimeConfiguration, Mode=TwoWay}"
                                             IsEnabled="{Binding IsTargetSelectionEnabled}"/>
                                <SelectableTextBlock Text="{Binding ManagedRuntimePath}"
                                                     Margin="26,0,0,0"
                                                     FontSize="10"
                                                     Foreground="{DynamicResource SecondaryTextBrush}"
                                                     TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Spacing="7">
                                <RadioButton Content="{loc:Loc Template.CopyOther}"
                                             GroupName="TemplateConfigurationSource"
                                             IsChecked="{Binding UsesOtherWorkspaceConfiguration, Mode=TwoWay}"
                                             IsEnabled="{Binding IsTargetSelectionEnabled}"/>
                                <Grid Margin="26,0,0,0"
                                      ColumnDefinitions="*,Auto"
                                      IsVisible="{Binding UsesOtherWorkspaceConfiguration}">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding TemplateWorkspaceConfigurationSourcePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Watermark="{loc:Loc Template.SourceWatermark}"
                                             FontFamily="Consolas,Menlo,Monaco,Courier New"
                                             Margin="0,0,8,0"
                                             IsEnabled="{Binding IsTargetSelectionEnabled}"/>
                                    <Button Grid.Column="1"
                                            Content="{loc:Loc Template.SelectWorkspace}"
                                            Command="{Binding SelectTemplateWorkspaceConfigurationSourceCommand}"
                                            Classes="secondary-action"/>
                                </Grid>
                            </StackPanel>
                            <TextBlock Text="{loc:Loc Template.ConfigCopyHint}"
                                       Margin="26,0,0,0"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="16"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Background="{DynamicResource ToolbarBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="12">
                    <TextBlock Text="{Binding TemplateCreationStatus}"
                               FontSize="10.5"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>
                </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource ToolbarBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0"
                           Text="{loc:Loc Template.NeedNetwork}"
                           FontSize="10.5"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="{loc:Loc Action.Close}" Click="CloseButton_OnClick"
                        Classes="secondary-action"/>
                <Button Grid.Column="2" Content="{loc:Loc Template.CreateWorkspace}"
                        Command="{Binding CreateWorkspaceFromTemplateCommand}"
                        Classes="primary-action"/>
            </Grid>
        </Border>
    </Grid>

    <Window.Styles>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.primary-action">
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#0F766E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.secondary-action">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource ToolbarBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Styles>
</Window>
