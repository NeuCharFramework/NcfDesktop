<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NcfDesktopApp.GUI.ViewModels"
        xmlns:loc="using:NcfDesktopApp.GUI.Markup"
             xmlns:controls="using:NcfDesktopApp.GUI.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="NcfDesktopApp.GUI.Views.BrowserView"
             x:DataType="vm:MainWindowViewModel"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    
    <Grid RowDefinitions="Auto,*"
          VerticalAlignment="Stretch"
          MinHeight="0"
          ClipToBounds="True">
        
        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="{DynamicResource ToolbarBackgroundBrush}" BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="0,0,0,1" Padding="8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                
                <Button Grid.Column="0"
                        Name="RefreshButton"
                        Content="↻"
                        Width="30" Height="30"
                        FontSize="16" FontWeight="Bold"
                        ToolTip.Tip="{loc:Loc Browser.RefreshTip}"
                        Click="RefreshButton_Click"/>
                
                <!-- 运行站点地址仅用于识别当前页面，站内导航由 WebView 自身处理。 -->
                <Border Grid.Column="1" 
                        Background="{DynamicResource InputBackgroundBrush}" 
                        BorderBrush="{DynamicResource InputBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="4" 
                        Margin="10,0">
                    <TextBox Name="UrlTextBox"
                             Text="{Binding SiteUrl, Mode=OneWay}"
                             FontFamily="Consolas"
                             FontSize="12"
                             Foreground="{DynamicResource InputTextBrush}"
                             VerticalAlignment="Center"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="8,5"
                             IsReadOnly="True"
                             ToolTip.Tip="{loc:Loc Browser.UrlTip}"/>
                </Border>
                
                <TextBlock Grid.Column="2"
                           Text="{Binding BrowserNavigationStatus}"
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                
                <Button Grid.Column="3"
                        Name="OpenExternalButton"
                        Content="↗"
                        Width="30" Height="30"
                        FontSize="15"
                        ToolTip.Tip="{loc:Loc Browser.OpenExternalTip}"
                        Margin="0,0,5,0"
                        Command="{Binding OpenInExternalBrowserCommand}"/>
                
                <Button Grid.Column="4" 
                        Content="⚙" 
                        Width="30" Height="30" 
                        FontSize="16"
                        ToolTip.Tip="{loc:Loc Browser.BackToWorkspaceTip}"
                        Command="{Binding SwitchToSettingsCommand}"/>
            </Grid>
        </Border>
        
        <!-- 浏览器内容区域 -->
        <Border Grid.Row="1"
                MinHeight="0"
                ClipToBounds="True"
                Background="{DynamicResource ContentBackgroundBrush}">
            <Grid MinHeight="0" ClipToBounds="True">
                <!-- 加载状态覆盖层 -->
                <Border Name="LoadingOverlay" 
                        Background="{DynamicResource ContentBackgroundBrush}" 
                        IsVisible="{Binding !IsBrowserReady}">
                    <StackPanel HorizontalAlignment="Center" 
                                VerticalAlignment="Center" 
                                Spacing="20">
                        <TextBlock Text="🌐" 
                                   FontSize="48" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Browser.Preparing}" 
                                   FontSize="16" 
                                   HorizontalAlignment="Center" 
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <ProgressBar IsIndeterminate="True" 
                                     Width="200" 
                                     Height="4"/>
                    </StackPanel>
                </Border>
                
                <!-- 内嵌浏览器控件 -->
                <!-- 🔧 方案1优化：移除 IsVisible 绑定，避免标签切换时 WebView 被隐藏 -->
                <!-- WebView 一旦初始化完成就保持可见，即使 IsBrowserReady 变化也不隐藏 -->
                <controls:EmbeddedWebView Name="WebViewControl"
                                       MinHeight="0"
                                       ClipToBounds="True"
                                       Source="{Binding SiteUrl}"/>
                
                <!-- 错误状态显示 -->
                <Border Name="ErrorOverlay" 
                        Background="{DynamicResource ContentBackgroundBrush}" 
                        IsVisible="{Binding HasBrowserError}">
                    <StackPanel HorizontalAlignment="Center" 
                                VerticalAlignment="Center" 
                                Spacing="15">
                        <TextBlock Text="⚠️" 
                                   FontSize="48" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Browser.LoadFailed}" 
                                   FontSize="18" 
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" 
                                   Foreground="#DC3545"/>
                        <TextBlock Text="{Binding BrowserErrorMessage}" 
                                   FontSize="14" 
                                   HorizontalAlignment="Center" 
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   MaxWidth="400"/>
                        <Button Content="{loc:Loc Action.Retry}" 
                                Command="{Binding RetryBrowserCommand}"
                                HorizontalAlignment="Center"
                                Padding="20,8"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
