<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NcfDesktopApp.GUI.ViewModels"
        x:Class="NcfDesktopApp.GUI.Views.WorkspaceSettingsWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="工作台设置"
        Width="820" Height="680"
        MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Opened="WorkspaceSettingsWindow_OnOpened"
        Icon="/Assets/NCF-logo.png">

    <Grid RowDefinitions="Auto,*,Auto"
          ClipToBounds="True"
          Background="{DynamicResource ContentBackgroundBrush}">
        <Border Grid.Row="0"
                Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource ToolbarBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,16">
            <StackPanel Spacing="3">
                <TextBlock Text="工作台设置" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="按类别配置工作台、语音模型、桌面宠物与托管 Runtime；更改会立即应用。"
                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1"
                    Classes="settings-navigation"
                    TabStripPlacement="Left"
                    MinHeight="0">
            <TabItem Header="常规">
                <ScrollViewer MinHeight="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Border Padding="20,16,20,20">
                        <StackPanel Spacing="12">
                <Border Classes="settings-section">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="启动配置" Classes="section-title"/>
                            <TextBlock Text="目标运行期间锁定；新的配置在下次启动时生效。"
                                       Classes="section-description"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ASP.NET Core 环境"
                                       Classes="field-label"/>
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding EnvironmentOptions}"
                                      SelectedItem="{Binding AspNetCoreEnvironment, Mode=TwoWay}"
                                      IsEnabled="{Binding IsTargetSelectionEnabled}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="本地端口范围"
                                       Classes="field-label"/>
                            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto,*">
                                <NumericUpDown Grid.Column="0"
                                               Value="{Binding StartPort}"
                                               Minimum="1024" Maximum="65535"
                                               IsEnabled="{Binding IsTargetSelectionEnabled}"/>
                                <TextBlock Grid.Column="1" Text="—" Margin="10,0"
                                           VerticalAlignment="Center"/>
                                <NumericUpDown Grid.Column="2"
                                               Value="{Binding EndPort}"
                                               Minimum="1024" Maximum="65535"
                                               IsEnabled="{Binding IsTargetSelectionEnabled}"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="settings-section">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="使用偏好" Classes="section-title"/>
                            <TextBlock Text="减少重复操作，并控制运行日志的详细程度。"
                                       Classes="section-description"/>
                        </StackPanel>
                        <CheckBox Content="目标就绪后自动打开内嵌站点"
                                  IsChecked="{Binding AutoOpenBrowser}"/>
                        <CheckBox Content="显示详细下载和启动日志"
                                  IsChecked="{Binding ShowDetailedInfo}"/>
                    </StackPanel>
                </Border>

                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="语音模型">
                <ScrollViewer MinHeight="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Border Padding="20,16,20,20">
                        <StackPanel Spacing="12">
                <Border Classes="settings-section">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="本地语音输入" Classes="section-title"/>
                            <TextBlock Text="模型只在本机加载；录音转写完成后先写入 AdminChat 输入框，可按下方设置确认后发送或自动发送。"
                                       Classes="section-description"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="离线模型"
                                       Classes="field-label"/>
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding VoiceModelOptions}"
                                      SelectedItem="{Binding SelectedVoiceModel, Mode=TwoWay}"
                                      DisplayMemberBinding="{Binding DisplayLabel}"
                                      PlaceholderText="请先选择模型"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="识别语言"
                                       Classes="field-label"/>
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      ItemsSource="{Binding VoiceLanguageOptions}"
                                      SelectedItem="{Binding VoiceLanguage, Mode=TwoWay}"/>
                        </Grid>

                        <TextBlock Text="{Binding SelectedVoiceModel.Description}"
                                   FontSize="10.5"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Border Background="#0D64748B" CornerRadius="6" Padding="10">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding VoiceModelStatusText}"
                                           Foreground="{Binding VoiceModelStatusColor}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <SelectableTextBlock Text="{Binding VoiceModelPathText}"
                                                     FontFamily="Consolas,Menlo,Monaco,Courier New"
                                                     FontSize="9.5"
                                                     TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding VoiceModelDownloadProgressText}"
                                           IsVisible="{Binding IsVoiceModelBusy}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <ProgressBar IsVisible="{Binding IsVoiceModelBusy}"
                                             IsIndeterminate="True" Height="4"/>
                            </StackPanel>
                        </Border>

                        <WrapPanel Orientation="Horizontal">
                            <Button Content="下载所选模型"
                                    Command="{Binding DownloadVoiceModelCommand}"
                                    Classes="primary-action"
                                    Margin="0,0,8,8"/>
                            <Button Content="选择本地模型"
                                    Command="{Binding SelectCustomVoiceModelCommand}"
                                    Classes="secondary-action"
                                    Margin="0,0,8,8"/>
                            <Button Content="打开模型目录"
                                    Command="{Binding OpenVoiceModelDirectoryCommand}"
                                    Classes="secondary-action"
                                    Margin="0,0,8,8"/>
                            <Button Content="取消"
                                    Command="{Binding CancelVoiceInputCommand}"
                                    IsVisible="{Binding IsVoiceCancelVisible}"
                                    Classes="secondary-action"
                                    Margin="0,0,0,8"/>
                        </WrapPanel>

                        <CheckBox Content="STT 识别完成后自动发送"
                                  IsChecked="{Binding SttAutoSend, Mode=TwoWay}"
                                  ToolTip.Tip="关闭时只把识别文字写入输入框；开启时会立即通过现有 AdminChat 发送流程发送。"/>

                        <Border Background="#0D2563EB" CornerRadius="7" Padding="11">
                            <StackPanel Spacing="7">
                                <CheckBox Content="启用固定唤醒词“你好 Cici”"
                                          IsChecked="{Binding WakeWordEnabled, Mode=TwoWay}"/>
                                <TextBlock Text="{Binding WakePhraseText, StringFormat='唤醒短语：{0}'}"
                                           FontWeight="SemiBold"
                                           FontSize="11"/>
                                <TextBlock Text="仅当 AdminChat、Whisper 与唤醒模型均就绪时才监听；关闭后立即释放麦克风。监听音频不保存、不上传，朗读和录音期间会自动暂停以防误触发。说完唤醒词后请稍作停顿再说指令。"
                                           FontSize="10.5"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding WakeWordStatusText}"
                                           Foreground="{Binding WakeWordStatusColor}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding WakeWordDownloadProgressText}"
                                           IsVisible="{Binding IsWakeWordModelBusy}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <ProgressBar IsVisible="{Binding IsWakeWordModelBusy}"
                                             IsIndeterminate="{Binding IsWakeWordDownloadProgressIndeterminate}"
                                             Value="{Binding WakeWordDownloadProgressValue}"
                                             Minimum="0" Maximum="100" Height="4"/>
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="下载唤醒模型"
                                            Command="{Binding DownloadWakeWordModelCommand}"
                                            Classes="primary-action"
                                            Margin="0,0,8,0"/>
                                    <Button Content="取消下载"
                                            Command="{Binding CancelWakeWordModelDownloadCommand}"
                                            IsVisible="{Binding IsWakeWordModelBusy}"
                                            Classes="secondary-action"
                                            Margin="0,0,8,0"/>
                                    <Button Content="打开唤醒模型目录"
                                            Command="{Binding OpenWakeWordModelDirectoryCommand}"
                                            Classes="secondary-action"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Classes="settings-section">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="本地语音输出（TTS）" Classes="section-title"/>
                            <TextBlock Text="Kokoro 在本机生成 AI 朗读音频，不上传回复文本或音频；模型大小为下载包估算值。"
                                       Classes="section-description"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="离线模型"
                                       Classes="field-label"/>
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding TtsModelOptions}"
                                      SelectedItem="{Binding SelectedTtsModel, Mode=TwoWay}"
                                      DisplayMemberBinding="{Binding DisplayLabel}"
                                      PlaceholderText="请先选择朗读模型"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="中文音色"
                                       Classes="field-label"/>
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      ItemsSource="{Binding TtsVoiceOptions}"
                                      SelectedItem="{Binding SelectedTtsVoice, Mode=TwoWay}"
                                      DisplayMemberBinding="{Binding DisplayName}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="语速"
                                       Classes="field-label"/>
                            <NumericUpDown Grid.Row="2" Grid.Column="1"
                                           Value="{Binding TtsSpeed, Mode=TwoWay}"
                                           Minimum="0.5" Maximum="2.0" Increment="0.05"/>
                        </Grid>

                        <TextBlock Text="{Binding SelectedTtsModel.Description}"
                                   FontSize="10.5"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding SelectedTtsVoice.Description}"
                                   FontSize="10.5"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <CheckBox Content="AI 回复完成后自动朗读"
                                  IsChecked="{Binding TtsAutoRead, Mode=TwoWay}"/>

                        <Border Background="#0D7C3AED" CornerRadius="6" Padding="10">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding TtsModelStatusText}"
                                           Foreground="{Binding TtsModelStatusColor}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <SelectableTextBlock Text="{Binding TtsModelPathText}"
                                                     FontFamily="Consolas,Menlo,Monaco,Courier New"
                                                     FontSize="9.5"
                                                     TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding TtsDownloadProgressText}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding TtsPlaybackStatusText}"
                                           FontSize="10.5"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <ProgressBar IsVisible="{Binding IsTtsModelBusy}"
                                             IsIndeterminate="True" Height="4"/>
                            </StackPanel>
                        </Border>

                        <WrapPanel Orientation="Horizontal">
                            <Button Content="下载所选模型"
                                    Command="{Binding DownloadTtsModelCommand}"
                                    Classes="primary-action"
                                    Margin="0,0,8,8"/>
                            <Button Content="选择本地模型目录"
                                    Command="{Binding SelectCustomTtsModelCommand}"
                                    Classes="secondary-action"
                                    Margin="0,0,8,8"/>
                            <Button Content="试听音色"
                                    Command="{Binding PreviewTtsVoiceCommand}"
                                    Classes="secondary-action"
                                    Margin="0,0,8,8"/>
                            <Button Content="停止 / 取消"
                                    Command="{Binding CancelTtsOperationCommand}"
                                    Classes="secondary-action"
                                    Margin="0,0,8,8"/>
                            <Button Content="打开模型目录"
                                    Command="{Binding OpenTtsModelDirectoryCommand}"
                                    Classes="secondary-action"
                                    Margin="0,0,0,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="桌面宠物">
                <ScrollViewer MinHeight="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Border Padding="20,16,20,20">
                        <StackPanel Spacing="12">
                            <Border Classes="settings-section">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="多个宠物的展示方式" Classes="section-title"/>
                                        <TextBlock Text="此偏好应用于所有工作区，可随时切换，不会停止正在运行的 NCF。"
                                                   Classes="section-description"/>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <Border Grid.Column="0"
                                                Padding="12"
                                                CornerRadius="10"
                                                Background="#0C2563EB"
                                                BorderBrush="#302563EB"
                                                BorderThickness="1">
                                            <RadioButton GroupName="DesktopRobotLayoutMode"
                                                         IsChecked="{Binding UsesFreeFloatingDesktopRobots, Mode=TwoWay}"
                                                         VerticalContentAlignment="Top">
                                                <StackPanel Spacing="4" Margin="4,0,0,0">
                                                    <TextBlock Text="自由浮动" FontWeight="SemiBold"/>
                                                    <TextBlock Text="每个工作区一个宠物，可分别拖动、悬停查看详情和双击语音。"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </RadioButton>
                                        </Border>

                                        <Border Grid.Column="1"
                                                Padding="12"
                                                CornerRadius="10"
                                                Background="#0C0F766E"
                                                BorderBrush="#300F766E"
                                                BorderThickness="1">
                                            <RadioButton GroupName="DesktopRobotLayoutMode"
                                                         IsChecked="{Binding UsesGroupedDesktopRobotList, Mode=TwoWay}"
                                                         VerticalContentAlignment="Top">
                                                <StackPanel Spacing="4" Margin="4,0,0,0">
                                                    <TextBlock Text="统一标签列表" FontWeight="SemiBold"/>
                                                    <TextBlock Text="收纳到一个置顶标签；仍显示名称、宠物、状态、详情、连接和常用操作。"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </RadioButton>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="settings-section">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="桌面宠物" Classes="section-title"/>
                                        <TextBlock Text="控制浮窗显示与大小。缩放只改变显示尺寸，不增加动画刷新频率。"
                                                   Classes="section-description"/>
                                    </StackPanel>

                                    <CheckBox Content="鼠标位于宠物上方时，允许使用滚轮调整大小"
                                              IsEnabled="{Binding UsesFreeFloatingDesktopRobots}"
                                              IsChecked="{Binding DesktopRobotWheelZoomEnabled, Mode=TwoWay}"/>

                                    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto" RowSpacing="10"
                                          IsEnabled="{Binding UsesFreeFloatingDesktopRobots}">
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="当前大小（倍）"
                                                   Classes="field-label"/>
                                        <NumericUpDown Grid.Row="0" Grid.Column="1"
                                                       Value="{Binding DesktopRobotScale, Mode=TwoWay}"
                                                       Minimum="1" Maximum="{Binding DesktopRobotMaximumScale}"
                                                       Increment="0.1"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Text="滚轮放大上限（倍）"
                                                   Classes="field-label"/>
                                        <NumericUpDown Grid.Row="1" Grid.Column="1"
                                                       Value="{Binding DesktopRobotMaximumScale, Mode=TwoWay}"
                                                       Minimum="1" Maximum="4"
                                                       Increment="0.1"/>
                                    </Grid>

                                    <TextBlock Text="大小与滚轮设置用于自由浮动模式；统一列表采用固定紧凑尺寸。1.0 倍是缩小下限，放大上限可设置到 4.0 倍。"
                                               Classes="section-description"/>

                                    <WrapPanel Orientation="Horizontal">
                                        <Button Content="显示桌面宠物"
                                                Command="{Binding ShowDesktopRobotCommand}"
                                                Classes="primary-action"
                                                Margin="0,0,8,8"/>
                                        <Button Content="恢复默认大小"
                                                Command="{Binding ResetDesktopRobotSizeCommand}"
                                                Classes="secondary-action"
                                                Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Runtime">
                <ScrollViewer MinHeight="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Border Padding="20,16,20,20">
                        <StackPanel Spacing="12">
                <Border Classes="settings-section">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="托管 Runtime" Classes="section-title"/>
                            <TextBlock Text="仅影响由桌面端下载和维护的托管版本。"
                                       Classes="section-description"/>
                        </StackPanel>
                        <CheckBox Content="安装完成后清理下载文件"
                                  IsChecked="{Binding AutoCleanDownloads}"
                                  IsEnabled="{Binding IsManagedTargetMode}"/>
                        <TextBox Text="{Binding MirrorServerBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="镜像服务器地址"
                                 IsEnabled="{Binding IsManagedTargetMode}"
                                 FontFamily="Consolas,Menlo,Monaco,Courier New"/>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    IsEnabled="{Binding IsManagedTargetMode}">
                            <Button Content="测试更新源"
                                    Command="{Binding TestConnectionCommand}"
                                    Classes="secondary-action"/>
                            <Button Content="打开配置目录"
                                    Command="{Binding OpenConfigDirectoryCommand}"
                                    Classes="secondary-action"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="关于">
                <ScrollViewer MinHeight="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Border Padding="20,16,20,20">
                        <StackPanel Spacing="12">
                            <Border Classes="settings-section">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="NCF Desktop" Classes="section-title"/>
                                        <TextBlock Text="查看包含 build 编号的当前版本，并检查是否有新版本可用。"
                                                   Classes="section-description"/>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="当前版本" Classes="field-label"/>
                                        <SelectableTextBlock Grid.Row="0" Grid.Column="1"
                                                             Text="{Binding DesktopAppCurrentVersion, StringFormat='v{0}'}"
                                                             FontWeight="SemiBold"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Text="最新版本" Classes="field-label"/>
                                        <SelectableTextBlock Grid.Row="1" Grid.Column="1"
                                                             Text="{Binding DesktopAppLatestVersion}"
                                                             FontWeight="SemiBold"/>
                                    </Grid>

                                    <Border Background="#0D2563EB" CornerRadius="6" Padding="10">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding DesktopAppUpdateStatus}"
                                                       Foreground="{Binding DesktopAppUpdateStatusColor}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <ProgressBar IsVisible="{Binding IsDesktopAppUpdateChecking}"
                                                         IsIndeterminate="True" Height="4"/>
                                        </StackPanel>
                                    </Border>

                                    <WrapPanel Orientation="Horizontal">
                                        <Button Content="重新检查"
                                                Command="{Binding CheckDesktopAppUpdateCommand}"
                                                IsEnabled="{Binding !IsDesktopAppUpdateChecking}"
                                                Classes="secondary-action"
                                                Margin="0,0,8,8"/>
                                        <Button Content="前往 NCF 官网下载"
                                                Command="{Binding OpenDesktopDownloadPageCommand}"
                                                Classes="primary-action"
                                                Margin="0,0,0,8"/>
                                    </WrapPanel>

                                    <TextBlock Text="程序启动后及每小时优先检查 NCF 官网发布信息；官网清单暂不可用时会自动回退 GitHub。下载入口始终打开 https://www.ncf.pub/Download。"
                                               Classes="section-description"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource ToolbarBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="设置保存在桌面端配置目录中。"
                           FontSize="10.5"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="完成" Click="CloseButton_OnClick"
                        Classes="primary-action"/>
            </Grid>
        </Border>
    </Grid>

    <Window.Styles>
        <Style Selector="TabControl.settings-navigation">
            <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}"/>
        </Style>
        <Style Selector="TabControl.settings-navigation TabItem">
            <Setter Property="MinWidth" Value="148"/>
            <Setter Property="Padding" Value="18,13"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Border.settings-section">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.section-description">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.primary-action">
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.secondary-action">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource ToolbarBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Styles>
</Window>
