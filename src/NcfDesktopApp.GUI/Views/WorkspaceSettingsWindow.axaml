<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NcfDesktopApp.GUI.ViewModels"
        xmlns:loc="using:NcfDesktopApp.GUI.Markup"
        xmlns:models="using:NcfDesktopApp.GUI.Models"
        x:Class="NcfDesktopApp.GUI.Views.WorkspaceSettingsWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="SettingsRoot"
        Title="{loc:Loc Settings.WindowTitle}"
        Width="820" Height="680"
        MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Opened="WorkspaceSettingsWindow_OnOpened"
        Icon="/Assets/NCF-logo.png">

    <Grid RowDefinitions="Auto,*,Auto"
          ClipToBounds="True"
          Background="{DynamicResource ContentBackgroundBrush}">
        <Border Grid.Row="0"
                Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource ToolbarBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,16">
            <StackPanel Spacing="3">
                <TextBlock Text="{loc:Loc Settings.Title}" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="{loc:Loc Settings.Subtitle}"
                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1"
                    Classes="settings-navigation"
                    TabStripPlacement="Left"
                    MinHeight="0">
            <TabItem Header="{loc:Loc Settings.TabGeneral}">
                <ScrollViewer MinHeight="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Border Padding="20,16,20,20">
                        <StackPanel Spacing="12">
                <Border Classes="settings-section">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:Loc Settings.LaunchConfig}" Classes="section-title"/>
                            <TextBlock Text="{loc:Loc Settings.LaunchConfigHint}"
                                       Classes="section-description"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Settings.AspNetEnv}"
                                       Classes="field-label"/>
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding EnvironmentOptions}"
                                      SelectedItem="{Binding AspNetCoreEnvironment, Mode=TwoWay}"
                                      IsEnabled="{Binding IsTargetSelectionEnabled}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Settings.PortRange}"
                                       Classes="field-label"/>
                            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto,*">
                                <NumericUpDown Grid.Column="0"
                                               Value="{Binding StartPort}"
                                               Minimum="1024" Maximum="65535"
                                               IsEnabled="{Binding IsTargetSelectionEnabled}"/>
                                <TextBlock Grid.Column="1" Text="{loc:Loc Common.EmDash}" Margin="10,0"
                                           VerticalAlignment="Center"/>
                                <NumericUpDown Grid.Column="2"
                                               Value="{Binding EndPort}"
                                               Minimum="1024" Maximum="65535"
                                               IsEnabled="{Binding IsTargetSelectionEnabled}"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="settings-section">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:Loc Settings.Preferences}" Classes="section-title"/>
                            <TextBlock Text="{loc:Loc Settings.PreferencesHint}"
                                       Classes="section-description"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Grid.Column="0"
                                       Text="{loc:Loc Settings.UiLanguage}"
                                       Classes="field-label"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding UiLanguageOptions}"
                                      SelectedItem="{Binding SelectedUiLanguageOption, Mode=TwoWay}"
                                      DisplayMemberBinding="{Binding DisplayName}"/>
                        </Grid>
                        <TextBlock Text="{loc:Loc Settings.UiLanguageHint}"
                                   Classes="section-description"/>
                        <CheckBox Content="{loc:Loc Settings.AutoOpenBrowser}"
                                  IsChecked="{Binding AutoOpenBrowser}"/>
                        <CheckBox Content="{loc:Loc Settings.ShowDetailedInfo}"
                                  IsChecked="{Binding ShowDetailedInfo}"/>
                    </StackPanel>
                </Border>

                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{loc:Loc Settings.TabVoice}">
                <ScrollViewer MinHeight="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Border Padding="20,16,20,20">
                        <StackPanel Spacing="12">
                <Border Classes="settings-section">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:Loc Settings.LocalVoice}" Classes="section-title"/>
                            <TextBlock Text="{loc:Loc Settings.LocalVoiceHint}"
                                       Classes="section-description"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Settings.OfflineModel}"
                                       Classes="field-label"/>
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding VoiceModelOptions}"
                                      SelectedItem="{Binding SelectedVoiceModel, Mode=TwoWay}"
                                      DisplayMemberBinding="{Binding DisplayLabel}"
                                      PlaceholderText="{loc:Loc Settings.SelectModelPlaceholder}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Settings.RecognitionLanguage}"
                                       Classes="field-label"/>
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      ItemsSource="{Binding VoiceLanguageOptions}"
                                      SelectedItem="{Binding VoiceLanguage, Mode=TwoWay}"/>
                        </Grid>

                        <TextBlock Text="{Binding SelectedVoiceModel.Description}"
                                   FontSize="10.5"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Border Background="#0D64748B" CornerRadius="6" Padding="10">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding VoiceModelStatusText}"
                                           Foreground="{Binding VoiceModelStatusColor}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <SelectableTextBlock Text="{Binding VoiceModelPathText}"
                                                     FontFamily="Consolas,Menlo,Monaco,Courier New"
                                                     FontSize="9.5"
                                                     TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding VoiceModelDownloadProgressText}"
                                           IsVisible="{Binding IsVoiceModelBusy}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <ProgressBar IsVisible="{Binding IsVoiceModelBusy}"
                                             IsIndeterminate="True" Height="4"/>
                            </StackPanel>
                        </Border>

                        <WrapPanel Orientation="Horizontal">
                            <Button Content="{loc:Loc Settings.DownloadSelectedModel}"
                                    Command="{Binding DownloadVoiceModelCommand}"
                                    Classes="primary-action"
                                    Margin="0,0,8,8"/>
                            <Button Content="{loc:Loc Settings.SelectLocalModel}"
                                    Command="{Binding SelectCustomVoiceModelCommand}"
                                    Classes="secondary-action"
                                    Margin="0,0,8,8"/>
                            <Button Content="{loc:Loc Settings.OpenModelDirectory}"
                                    Command="{Binding OpenVoiceModelDirectoryCommand}"
                                    Classes="secondary-action"
                                    Margin="0,0,8,8"/>
                            <Button Content="{loc:Loc Action.Cancel}"
                                    Command="{Binding CancelVoiceInputCommand}"
                                    IsVisible="{Binding IsVoiceCancelVisible}"
                                    Classes="secondary-action"
                                    Margin="0,0,0,8"/>
                        </WrapPanel>

                        <CheckBox Content="{loc:Loc Settings.SttAutoSend}"
                                  IsChecked="{Binding SttAutoSend, Mode=TwoWay}"
                                  ToolTip.Tip="{loc:Loc Settings.SttAutoSendTip}"/>

                        <Border Background="#0D2563EB" CornerRadius="7" Padding="11">
                            <StackPanel Spacing="7">
                                <CheckBox Content="{Binding WakeWordEnableLabel}"
                                          IsChecked="{Binding WakeWordEnabled, Mode=TwoWay}"/>
                                <TextBlock Text="{Binding WakePhraseLabel}"
                                           FontWeight="SemiBold"
                                           FontSize="11"/>
                                <TextBlock Text="{loc:Loc Settings.WakeWordHint}"
                                           FontSize="10.5"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{loc:Loc Settings.WakeWordsTitle}"
                                           FontWeight="SemiBold"
                                           Margin="0,5,0,0"/>
                                <TextBlock Text="{loc:Loc Settings.WakeWordsHint}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <ItemsControl ItemsSource="{Binding WakeWordConfigurations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:WakeWordConfiguration">
                                            <Border Tag="WakeWordItem"
                                                    Background="{DynamicResource ToolbarBackgroundBrush}"
                                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="8"
                                                    Margin="0,3">
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                                        <RadioButton Grid.Column="0"
                                                                     GroupName="WakeWordDefault"
                                                                     IsChecked="{Binding IsDefault, Mode=TwoWay}"
                                                                     VerticalAlignment="Center"
                                                                     ToolTip.Tip="{loc:Loc Settings.WakeSetDefaultTip}"/>
                                                        <CheckBox Grid.Column="1"
                                                                  Content="{loc:Loc Settings.WakeEnabled}"
                                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                  Margin="6,0"
                                                                  VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="2"
                                                                 Text="{Binding Phrase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Watermark="{loc:Loc Settings.WakePhraseWatermark}"
                                                                 Margin="6,0"
                                                                 MinWidth="150"/>
                                                        <Button Grid.Column="3"
                                                                Content="{loc:Loc Settings.WakeRemove}"
                                                                Classes="secondary-action"
                                                                Click="WakeWordRemoveButton_OnClick"/>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="95,*,Auto,Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{loc:Loc Settings.WakePinyin}"
                                                                   Classes="field-label"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="1"
                                                                 Tag="WakePinyinInput"
                                                                 Text="{Binding Pinyin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Watermark="{loc:Loc Settings.WakePinyinWatermark}"
                                                                 FontFamily="Consolas,Menlo,Monaco,Courier New"/>
                                                        <Button Grid.Column="2"
                                                                Content="↻"
                                                                Click="WakeWordAutoPinyinButton_OnClick"
                                                                Classes="secondary-action"
                                                                Margin="6,0,0,0"
                                                                ToolTip.Tip="{loc:Loc Settings.WakeAutoPinyinTip}"/>
                                                        <Button Grid.Column="3"
                                                                Content="◌"
                                                                Classes="secondary-action"
                                                                Margin="6,0,0,0"
                                                                ToolTip.Tip="{loc:Loc Settings.WakeToneSymbolsTip}">
                                                            <Button.Flyout>
                                                                <Flyout Placement="Bottom">
                                                                    <Border Padding="8"
                                                                            Background="{DynamicResource CardBackgroundBrush}"
                                                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="6">
                                                                        <WrapPanel ItemWidth="34" ItemHeight="30">
                                                                            <Button Content="ā" Tag="ā" Click="WakePinyinSymbolButton_OnClick"/>
                                                                            <Button Content="á" Tag="á" Click="WakePinyinSymbolButton_OnClick"/>
                                                                            <Button Content="ǎ" Tag="ǎ" Click="WakePinyinSymbolButton_OnClick"/>
                                                                            <Button Content="à" Tag="à" Click="WakePinyinSymbolButton_OnClick"/>
                                                                            <Button Content="ē" Tag="ē" Click="WakePinyinSymbolButton_OnClick"/>
                                                                            <Button Content="é" Tag="é" Click="WakePinyinSymbolButton_OnClick"/>
                                                                            <Button Content="ě" Tag="ě" Click="WakePinyinSymbolButton_OnClick"/>
                                                                            <Button Content="è" Tag="è" Click="WakePinyinSymbolButton_OnClick"/>
                                                                            <Button Content="ī" Tag="ī" Click="WakePinyinSymbolButton_OnClick"/>
                                                                            <Button Content="í" Tag="í" Click="WakePinyinSymbolButton_OnClick"/>
                                                                            <Button Content="ǐ" Tag="ǐ" Click="WakePinyinSymbolButton_OnClick"/>
                                                                            <Button Content="ì" Tag="ì" Click="WakePinyinSymbolButton_OnClick"/>
                                                                            <Button Content="ō" Tag="ō" Click="WakePinyinSymbolButton_OnClick"/>
                                                                            <Button Content="ó" Tag="ó" Click="WakePinyinSymbolButton_OnClick"/>
                                                                            <Button Content="ǒ" Tag="ǒ" Click="WakePinyinSymbolButton_OnClick"/>
                                                                            <Button Content="ò" Tag="ò" Click="WakePinyinSymbolButton_OnClick"/>
                                                                            <Button Content="ū" Tag="ū" Click="WakePinyinSymbolButton_OnClick"/>
                                                                            <Button Content="ú" Tag="ú" Click="WakePinyinSymbolButton_OnClick"/>
                                                                            <Button Content="ǔ" Tag="ǔ" Click="WakePinyinSymbolButton_OnClick"/>
                                                                            <Button Content="ù" Tag="ù" Click="WakePinyinSymbolButton_OnClick"/>
                                                                            <Button Content="ǖ" Tag="ǖ" Click="WakePinyinSymbolButton_OnClick"/>
                                                                            <Button Content="ǘ" Tag="ǘ" Click="WakePinyinSymbolButton_OnClick"/>
                                                                            <Button Content="ǚ" Tag="ǚ" Click="WakePinyinSymbolButton_OnClick"/>
                                                                            <Button Content="ǜ" Tag="ǜ" Click="WakePinyinSymbolButton_OnClick"/>
                                                                        </WrapPanel>
                                                                    </Border>
                                                                </Flyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                    </Grid>
                                                    <TextBlock Text="{Binding WakeDetectionValidationMessage}"
                                                               Foreground="{Binding WakeDetectionValidationColor}"
                                                               FontSize="9.5"
                                                               TextWrapping="Wrap"/>
                                                    <Grid ColumnDefinitions="95,*">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{loc:Loc Settings.WakeTargetChat}"
                                                                   Classes="field-label"
                                                                   VerticalAlignment="Center"/>
                                                        <ComboBox Grid.Column="1"
                                                                  ItemsSource="{Binding #SettingsRoot.DataContext.WakeWordChatSessionOptions}"
                                                                  SelectedItem="{Binding SelectedTargetSession, Mode=TwoWay}"
                                                                  DisplayMemberBinding="{Binding DisplayName}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="{loc:Loc Settings.WakeAdd}"
                                            Command="{Binding AddWakeWordCommand}"
                                            Classes="secondary-action"
                                            Margin="0,0,8,0"/>
                                    <Button Content="{loc:Loc Settings.WakeApply}"
                                            Command="{Binding ApplyWakeWordConfigurationCommand}"
                                            Classes="primary-action"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding WakeWordConfigurationStatusText}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding WakeWordStatusText}"
                                           Foreground="{Binding WakeWordStatusColor}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding WakeWordDownloadProgressText}"
                                           IsVisible="{Binding IsWakeWordModelBusy}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <ProgressBar IsVisible="{Binding IsWakeWordModelBusy}"
                                             IsIndeterminate="{Binding IsWakeWordDownloadProgressIndeterminate}"
                                             Value="{Binding WakeWordDownloadProgressValue}"
                                             Minimum="0" Maximum="100" Height="4"/>
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="{loc:Loc Settings.DownloadWakeModel}"
                                            Command="{Binding DownloadWakeWordModelCommand}"
                                            Classes="primary-action"
                                            Margin="0,0,8,0"/>
                                    <Button Content="{loc:Loc Settings.CancelDownload}"
                                            Command="{Binding CancelWakeWordModelDownloadCommand}"
                                            IsVisible="{Binding IsWakeWordModelBusy}"
                                            Classes="secondary-action"
                                            Margin="0,0,8,0"/>
                                    <Button Content="{loc:Loc Settings.OpenWakeModelDirectory}"
                                            Command="{Binding OpenWakeWordModelDirectoryCommand}"
                                            Classes="secondary-action"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Classes="settings-section">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:Loc Settings.LocalTts}" Classes="section-title"/>
                            <TextBlock Text="{loc:Loc Settings.LocalTtsHint}"
                                       Classes="section-description"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Settings.OfflineModel}"
                                       Classes="field-label"/>
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding TtsModelOptions}"
                                      SelectedItem="{Binding SelectedTtsModel, Mode=TwoWay}"
                                      DisplayMemberBinding="{Binding DisplayLabel}"
                                      PlaceholderText="{loc:Loc Settings.SelectTtsPlaceholder}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Settings.ChineseVoice}"
                                       Classes="field-label"/>
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      ItemsSource="{Binding TtsVoiceOptions}"
                                      SelectedItem="{Binding SelectedTtsVoice, Mode=TwoWay}"
                                      DisplayMemberBinding="{Binding DisplayName}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Settings.SpeechRate}"
                                       Classes="field-label"/>
                            <NumericUpDown Grid.Row="2" Grid.Column="1"
                                           Value="{Binding TtsSpeed, Mode=TwoWay}"
                                           Minimum="0.5" Maximum="2.0" Increment="0.05"/>
                        </Grid>

                        <TextBlock Text="{Binding SelectedTtsModel.Description}"
                                   FontSize="10.5"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding SelectedTtsVoice.Description}"
                                   FontSize="10.5"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <CheckBox Content="{loc:Loc Settings.TtsAutoRead}"
                                  IsChecked="{Binding TtsAutoRead, Mode=TwoWay}"/>

                        <Border Background="#0D7C3AED" CornerRadius="6" Padding="10">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding TtsModelStatusText}"
                                           Foreground="{Binding TtsModelStatusColor}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <SelectableTextBlock Text="{Binding TtsModelPathText}"
                                                     FontFamily="Consolas,Menlo,Monaco,Courier New"
                                                     FontSize="9.5"
                                                     TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding TtsDownloadProgressText}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding TtsPlaybackStatusText}"
                                           FontSize="10.5"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <ProgressBar IsVisible="{Binding IsTtsModelBusy}"
                                             IsIndeterminate="True" Height="4"/>
                            </StackPanel>
                        </Border>

                        <WrapPanel Orientation="Horizontal">
                            <Button Content="{loc:Loc Settings.DownloadSelectedModel}"
                                    Command="{Binding DownloadTtsModelCommand}"
                                    Classes="primary-action"
                                    Margin="0,0,8,8"/>
                            <Button Content="{loc:Loc Settings.SelectLocalTtsDirectory}"
                                    Command="{Binding SelectCustomTtsModelCommand}"
                                    Classes="secondary-action"
                                    Margin="0,0,8,8"/>
                            <Button Content="{loc:Loc Settings.PreviewVoice}"
                                    Command="{Binding PreviewTtsVoiceCommand}"
                                    Classes="secondary-action"
                                    Margin="0,0,8,8"/>
                            <Button Content="{loc:Loc Settings.StopCancel}"
                                    Command="{Binding CancelTtsOperationCommand}"
                                    Classes="secondary-action"
                                    Margin="0,0,8,8"/>
                            <Button Content="{loc:Loc Settings.OpenModelDirectory}"
                                    Command="{Binding OpenTtsModelDirectoryCommand}"
                                    Classes="secondary-action"
                                    Margin="0,0,0,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{loc:Loc Settings.TabRobot}">
                <ScrollViewer MinHeight="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Border Padding="20,16,20,20">
                        <StackPanel Spacing="12">
                            <Border Classes="settings-section">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{loc:Loc Settings.RobotLayoutTitle}" Classes="section-title"/>
                                        <TextBlock Text="{loc:Loc Settings.RobotLayoutHint}"
                                                   Classes="section-description"/>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <Border Grid.Column="0"
                                                Padding="12"
                                                CornerRadius="10"
                                                Background="#0C2563EB"
                                                BorderBrush="#302563EB"
                                                BorderThickness="1">
                                            <RadioButton GroupName="DesktopRobotLayoutMode"
                                                         IsChecked="{Binding UsesFreeFloatingDesktopRobots, Mode=TwoWay}"
                                                         VerticalContentAlignment="Top">
                                                <StackPanel Spacing="4" Margin="4,0,0,0">
                                                    <TextBlock Text="{loc:Loc Settings.FreeFloating}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{loc:Loc Settings.FreeFloatingHint}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </RadioButton>
                                        </Border>

                                        <Border Grid.Column="1"
                                                Padding="12"
                                                CornerRadius="10"
                                                Background="#0C0F766E"
                                                BorderBrush="#300F766E"
                                                BorderThickness="1">
                                            <RadioButton GroupName="DesktopRobotLayoutMode"
                                                         IsChecked="{Binding UsesGroupedDesktopRobotList, Mode=TwoWay}"
                                                         VerticalContentAlignment="Top">
                                                <StackPanel Spacing="4" Margin="4,0,0,0">
                                                    <TextBlock Text="{loc:Loc Settings.GroupedList}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{loc:Loc Settings.GroupedListHint}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </RadioButton>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="settings-section">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{loc:Loc Settings.DesktopRobot}" Classes="section-title"/>
                                        <TextBlock Text="{loc:Loc Settings.DesktopRobotHint}"
                                                   Classes="section-description"/>
                                    </StackPanel>

                                    <CheckBox Content="{loc:Loc Settings.WheelZoom}"
                                              IsEnabled="{Binding UsesFreeFloatingDesktopRobots}"
                                              IsChecked="{Binding DesktopRobotWheelZoomEnabled, Mode=TwoWay}"/>

                                    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto" RowSpacing="10"
                                          IsEnabled="{Binding UsesFreeFloatingDesktopRobots}">
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{loc:Loc Settings.CurrentScale}"
                                                   Classes="field-label"/>
                                        <NumericUpDown Grid.Row="0" Grid.Column="1"
                                                       Value="{Binding DesktopRobotScale, Mode=TwoWay}"
                                                       Minimum="1" Maximum="{Binding DesktopRobotMaximumScale}"
                                                       Increment="0.1"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Text="{loc:Loc Settings.MaxScale}"
                                                   Classes="field-label"/>
                                        <NumericUpDown Grid.Row="1" Grid.Column="1"
                                                       Value="{Binding DesktopRobotMaximumScale, Mode=TwoWay}"
                                                       Minimum="1" Maximum="4"
                                                       Increment="0.1"/>
                                    </Grid>

                                    <TextBlock Text="{loc:Loc Settings.ScaleHint}"
                                               Classes="section-description"/>

                                    <WrapPanel Orientation="Horizontal">
                                        <Button Content="{loc:Loc Settings.ShowDesktopRobot}"
                                                Command="{Binding ShowDesktopRobotCommand}"
                                                Classes="primary-action"
                                                Margin="0,0,8,8"/>
                                        <Button Content="{loc:Loc Settings.ResetRobotSize}"
                                                Command="{Binding ResetDesktopRobotSizeCommand}"
                                                Classes="secondary-action"
                                                Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{loc:Loc Settings.TabRuntime}">
                <ScrollViewer MinHeight="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Border Padding="20,16,20,20">
                        <StackPanel Spacing="12">
                <Border Classes="settings-section">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:Loc Settings.ManagedRuntime}" Classes="section-title"/>
                            <TextBlock Text="{loc:Loc Settings.ManagedRuntimeHint}"
                                       Classes="section-description"/>
                        </StackPanel>
                        <CheckBox Content="{loc:Loc Settings.AutoCleanDownloads}"
                                  IsChecked="{Binding AutoCleanDownloads}"
                                  IsEnabled="{Binding IsManagedTargetMode}"/>
                        <TextBox Text="{Binding MirrorServerBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="{loc:Loc Settings.MirrorWatermark}"
                                 IsEnabled="{Binding IsManagedTargetMode}"
                                 FontFamily="Consolas,Menlo,Monaco,Courier New"/>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    IsEnabled="{Binding IsManagedTargetMode}">
                            <Button Content="{loc:Loc Settings.TestUpdateSource}"
                                    Command="{Binding TestConnectionCommand}"
                                    Classes="secondary-action"/>
                            <Button Content="{loc:Loc Settings.OpenConfigDirectory}"
                                    Command="{Binding OpenConfigDirectoryCommand}"
                                    Classes="secondary-action"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{loc:Loc Settings.TabAbout}">
                <ScrollViewer MinHeight="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Border Padding="20,16,20,20">
                        <StackPanel Spacing="12">
                            <Border Classes="settings-section">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{loc:Loc Settings.AboutTitle}" Classes="section-title"/>
                                        <TextBlock Text="{loc:Loc Settings.AboutHint}"
                                                   Classes="section-description"/>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{loc:Loc Settings.CurrentVersion}" Classes="field-label"/>
                                        <SelectableTextBlock Grid.Row="0" Grid.Column="1"
                                                             Text="{Binding DesktopAppCurrentVersion, StringFormat='v{0}'}"
                                                             FontWeight="SemiBold"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Text="{loc:Loc Settings.LatestVersion}" Classes="field-label"/>
                                        <SelectableTextBlock Grid.Row="1" Grid.Column="1"
                                                             Text="{Binding DesktopAppLatestVersion}"
                                                             FontWeight="SemiBold"/>
                                    </Grid>

                                    <Border Background="#0D2563EB" CornerRadius="6" Padding="10">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding DesktopAppUpdateStatus}"
                                                       Foreground="{Binding DesktopAppUpdateStatusColor}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <ProgressBar IsVisible="{Binding IsDesktopAppUpdateChecking}"
                                                         IsIndeterminate="True" Height="4"/>
                                        </StackPanel>
                                    </Border>

                                    <WrapPanel Orientation="Horizontal">
                                        <Button Content="{loc:Loc Settings.Recheck}"
                                                Command="{Binding CheckDesktopAppUpdateCommand}"
                                                IsEnabled="{Binding !IsDesktopAppUpdateChecking}"
                                                Classes="secondary-action"
                                                Margin="0,0,8,8"/>
                                        <Button Content="{loc:Loc Settings.GoDownload}"
                                                Command="{Binding OpenDesktopDownloadPageCommand}"
                                                Classes="primary-action"
                                                Margin="0,0,0,8"/>
                                    </WrapPanel>

                                    <TextBlock Text="{loc:Loc Settings.AboutFooter}"
                                               Classes="section-description"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource ToolbarBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{loc:Loc Settings.SavedHint}"
                           FontSize="10.5"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="{loc:Loc Action.Done}" Click="CloseButton_OnClick"
                        Classes="primary-action"/>
            </Grid>
        </Border>
    </Grid>

    <Window.Styles>
        <Style Selector="TabControl.settings-navigation">
            <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}"/>
        </Style>
        <Style Selector="TabControl.settings-navigation TabItem">
            <Setter Property="MinWidth" Value="148"/>
            <Setter Property="Padding" Value="18,13"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Border.settings-section">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.section-description">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.primary-action">
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.secondary-action">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource ToolbarBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Styles>
</Window>
