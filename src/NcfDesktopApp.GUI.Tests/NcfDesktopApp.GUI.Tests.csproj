<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Version>0.3.6</Version>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageReleaseNotes>
      [2026-07-25] v0.1.0 验证 DesktopBridge 探测兼容性
      1、覆盖未安装、未启用、协议不兼容、网络异常和正常连接结果
      2、验证会话令牌通过专用请求头发送
      [2026-07-29] v0.1.1 补充 macOS WebView 原生编辑桥接测试
      1、验证 macOS 使用原生编辑命令并在其他平台保留脚本桥接路径
      [2026-07-30] v0.2.0 验证远程站点和模板工作区安全边界
      1、覆盖远程 HTTPS、非回环 HTTP 拒绝和回环 SSH 隧道地址
      2、覆盖模板目标目录防覆盖与路径逃逸保护
      [2026-08-01] v0.2.1 验证 DesktopBridge 管理员配对客户端
      1、验证创建和轮询配对请求时不会误发已有 DesktopBridge 令牌
      2、验证批准响应中的独立会话令牌可被桌面端读取
      [2026-08-01] v0.3.0 验证本地语音模型前置条件
      1、覆盖未选择、未下载、下载不完整及手动模型就绪状态
      [2026-08-01] v0.3.1 验证 DesktopBridge 活动会话撤销
      1、覆盖已连接 SSE 结束后立即复核授权并通知工作台退出
      [2026-08-04] v0.3.2 扩展桌面运行时兼容性与语音交互测试覆盖
      1、验证音频频谱、流式播放队列、TTS 文本分段及本地模型目录
      2、验证唤醒词模型、语音分析、桌面设置和机器人布局策略
      3、验证更新源选择、滚动策略及 net8.0 桌面运行时兼容性
      [2026-08-12] v0.3.3 扩展唤醒词会话激活与 Agent Portal、语音端点测试
      1、覆盖 macOS 当前会话唤醒词激活策略、监听状态及语音端点检测行为
      2、补充 Agent Portal 投影、AdminChat 会话刷新、桌面设置和本地模型目录的稳定性回归验证
      [2026-08-15] v0.3.4 扩展风噪端点、流式 TTS 分段与 Agent Portal 去重测试
      1、覆盖低频风噪、讲话后变大的背景噪声、最长讲话时长及语音频带自适应底噪行为
      2、验证流式朗读首段早边界、后续段标点等待与扩展上限强制截断
      3、验证 Agent Portal 对重复快照实体的去重投影
      [2026-08-26] v0.3.5 扩展自定义唤醒词、设置持久化与 AdminChat 绑定测试
      1、覆盖自定义唤醒短语目录、拼音转换与模型策略
      2、验证桌面设置对唤醒词列表的规范化与持久化
      3、验证 AdminChat 客户端与目标会话相关行为
      [2026-08-28] v0.3.6 扩展中英双语唤醒词模型目录测试
      1、覆盖中文与中英混合模型选项、校验与查找行为
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NcfDesktopApp.GUI\NcfDesktopApp.GUI.csproj" />
  </ItemGroup>
</Project>
